# Built directly on the official PHP image, so a rebuild picks up a new PHP release as soon as the PHP team
# publishes it. Everything the phpswoole/swoole Alpine image used to provide (Swoole, Redis, pdo_mysql,
# sockets, Composer) is installed here instead. As before, the Alpine image has no Supervisor or entrypoint.

ARG PHP_VERSION=8.4
ARG COMPOSER_VERSION=2

FROM composer:${COMPOSER_VERSION} AS composer

FROM php:${PHP_VERSION}-cli-alpine

# Swoole is built from https://github.com/swoole/swoole-src at this tag.
ARG SWOOLE_VERSION=6.2.6
ARG REDIS_VERSION=6.3.0
# Latest stable release by default; set to e.g. "mongodb-2.5.8" to pin.
ARG MONGODB_PACKAGE=mongodb

COPY --from=composer /usr/bin/composer /usr/bin/composer

RUN set -eux; \
    # Runtime libraries for Swoole. musl has no ucontext functions, so libucontext provides them on CPUs that
    # Swoole has no context-switching assembly for.
    apk add --no-cache \
        libstdc++ \
        libpq \
        libssh2 \
        libucontext \
        unixodbc; \
    # Libraries for the other extensions.
    apk add --no-cache \
        icu-dev \
        libzip-dev \
        freetype-dev \
        jpeg-dev \
        libpng-dev \
        libwebp-dev \
        oniguruma-dev \
        openssl-dev \
        zlib-dev \
        gettext-dev; \
    apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        linux-headers \
        brotli-dev \
        curl-dev \
        libssh2-dev \
        libucontext-dev \
        pcre-dev \
        pcre2-dev \
        postgresql-dev \
        sqlite-dev \
        unixodbc-dev; \
    docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp; \
    docker-php-ext-install -j"$(nproc)" pdo_mysql sockets gd intl zip gettext bcmath pcntl exif; \
    pecl channel-update pecl.php.net; \
    pecl install --configureoptions 'enable-redis-igbinary="no" enable-redis-lzf="yes" enable-redis-zstd="yes" enable-redis-msgpack="no" enable-redis-lz4="no" with-liblz4="yes"' "redis-${REDIS_VERSION}"; \
    pecl install "${MONGODB_PACKAGE}"; \
    docker-php-ext-enable redis mongodb; \
    docker-php-source extract; \
    mkdir /usr/src/php/ext/swoole; \
    curl -sSfL --retry 5 "https://github.com/swoole/swoole-src/archive/v${SWOOLE_VERSION}.tar.gz" -o /tmp/swoole.tar.gz; \
    tar xfz /tmp/swoole.tar.gz --strip-components=1 -C /usr/src/php/ext/swoole; \
    export LDFLAGS="${LDFLAGS:-} -lucontext"; \
    docker-php-ext-configure swoole \
        --enable-brotli \
        --enable-mysqlnd \
        --enable-sockets \
        --enable-swoole-curl \
        --enable-swoole-ftp \
        --enable-swoole-pgsql \
        --enable-swoole-sqlite \
        --enable-swoole-stdext \
        --enable-zstd \
        --with-swoole-odbc=unixODBC,/usr \
        --with-swoole-ssh2; \
    docker-php-ext-install -j"$(nproc)" swoole; \
    docker-php-source delete; \
    apk del .build-deps; \
    rm -rf /tmp/* /var/cache/apk/*

COPY configs/php.ini "/usr/local/etc/php/php.ini"

# Fail the build rather than publish an image with a missing or unloadable extension: PHP only prints a
# warning for an extension it cannot load and still exits 0.
RUN set -eux; \
    php -r 'foreach (["swoole", "mongodb", "redis", "pdo_mysql", "sockets", "gd", "intl", "zip", "gettext", "bcmath", "pcntl", "exif", "Zend OPcache", "sodium"] as $e) { if (!extension_loaded($e)) { fwrite(STDERR, "Missing PHP extension: $e\n"); exit(1); } }'; \
    if php -v 2>&1 | grep -qi warning; then php -v; exit 1; fi; \
    composer --version

WORKDIR /app
