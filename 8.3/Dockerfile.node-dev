FROM phpswoole/swoole:5.1-php8.3

ARG NODE_VERSION=22


RUN apt-get update && apt-get install -y ca-certificates curl gnupg libicu-dev libzip-dev libfreetype-dev libjpeg62-turbo-dev libpng-dev  \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_$NODE_VERSION.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY configs/php.ini "/usr/local/etc/php/php.ini"
COPY configs/supervisor/npm.conf "/etc/supervisor/conf.d/npm.conf"

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd intl zip gettext bcmath pcntl exif


# RUN apt-get update && apt-get install -y \
#     git \
#     unzip \
#     libssl-dev \
#     pkg-config \
#     && rm -rf /var/lib/apt/lists/*


# Clone MongoDB extension from GitHub at the tag you want (v1.21.0 here)
# RUN git clone --branch 1.21.0 https://github.com/mongodb/mongo-php-driver.git \
#     && cd mongo-php-driver \
#     && git submodule update --init \
#     && phpize \
#     && ./configure \
#     && make -j$(nproc) \
#     && make all \
#     && make install \
#     && docker-php-ext-enable mongodb \
#     && cd .. \
#     && rm -rf mongo-php-driver

RUN pecl install mongodb \
    && docker-php-ext-enable mongodb

WORKDIR /app